# ============================================================
#  复制这个文件为 .env，填入你自己的配置（.env 不会被提交到 git）
# ============================================================

# ---------- 同步引擎 ----------
# sync   : 增量同步（推荐）——逐表比对，只同步新增/修改/删除的行
# stream : 全量覆盖——每次推倒重来，纯 Node 驱动，零二进制依赖
# dump   : 全量覆盖——用 mysqldump / mysql 客户端，需要服务器装 MySQL 客户端
CLONE_ENGINE=sync

# ---------- 主库（源，只读） ----------
SOURCE_HOST=your-source-host
SOURCE_PORT=3306
SOURCE_USER=clone_user
SOURCE_PASSWORD=your_password
SOURCE_DATABASE=my_database

# ---------- 备库（目标，会被覆盖！） ----------
TARGET_HOST=your-target-host
TARGET_PORT=3306
TARGET_USER=clone_user
TARGET_PASSWORD=your_password
# 目标库名，留空表示与源库同名
TARGET_DATABASE=my_database

# ---------- 安全开关（重要） ----------
# 同步会覆盖/删除目标库的数据，属于破坏性操作。
# 必须显式设为 true 才会真正执行，防止误连生产库。
ALLOW_OVERWRITE=true

# ---------- 增量同步行为 ----------
# 目标库里源库已经没有的表 / 列 / 行，是否一并删除（关掉则只增不改不删）
SYNC_DROP_EXTRA_TABLES=true
SYNC_DROP_EXTRA_COLUMNS=true
SYNC_DROP_EXTRA_ROWS=true

# 只同步指定的表（逗号分隔，留空=全部），或排除指定的表
TABLES_INCLUDE=
TABLES_EXCLUDE=

# ---------- 调度 ----------
# 本项目不做常驻调度，程序跑完一次就退出。
# 定时交给服务器的系统 cron，见 deploy/crontab.example

# ---------- 导出文件（只有 dump 引擎用得到） ----------
DUMP_DIR=./dumps
KEEP_DUMPS=7
DUMP_EXTRA_OPTIONS=
MYSQL_BIN_DIR=

# ---------- 校验 ----------
# 同步后逐表对比两边行数（count=精确 / estimate=快但不精确 / off=不校验）
# 增量模式且完全没变动时会自动跳过校验
VERIFY_MODE=count

# ---------- 邮件告警 ----------
# 只在程序自己解决不了问题时发信；常见的版本/字符集/索引冲突会自动处理，不打扰你
# 163 邮箱的 SMTP_PASS 要填「授权码」，不是登录密码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=you@163.com
SMTP_PASS=your_smtp_auth_code
MAIL_FROM=you@163.com
MAIL_TO=someone@qq.com
# 每次成功都发一封日报？默认 false，只在有问题时发
MAIL_ON_SUCCESS=false

# ---------- 其他通知（可选） ----------
# 企业微信：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
# 钉钉：    https://oapi.dingtalk.com/robot/send?access_token=xxx
NOTIFY_WEBHOOK=
