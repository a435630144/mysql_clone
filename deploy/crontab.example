# ============================================================
#  定时调度：全部交给服务器的系统 cron
#  执行 crontab -e，粘贴下面内容（把路径改成你自己的）
#  程序本身跑完一次就退出，不常驻，小内存服务器没有常驻开销
# ============================================================

# 每天凌晨 3:00 克隆一次（用 node 的绝对路径，cron 的 PATH 很干净）
0 3 * * * cd /opt/copy_database && /usr/bin/node src/index.js --once >> /var/log/mysql-clone.log 2>&1

# 每周日凌晨 4:00 清理 30 天前的日志，防止日志撑爆磁盘
0 4 * * 0 find /opt/copy_database/logs -name '*.log' -mtime +30 -delete

# ------------------------------------------------------------
#  Docker 部署的话，把上面第一行换成：
#  0 3 * * * cd /opt/copy_database && docker compose run --rm mysql-clone >> /var/log/mysql-clone.log 2>&1
# ------------------------------------------------------------

# node 的绝对路径可以用 which node 查
